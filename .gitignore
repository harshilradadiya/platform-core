# -----------------------------------------------------------------------------
# Environment & Secrets
# NEVER commit real .env files — only .env.example files
# -----------------------------------------------------------------------------
.env
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
.env.staging
*.pem
*.key
*.cert
*.p12
*.pfx
secrets/


# -----------------------------------------------------------------------------
# Next.js / Node.js (frontend/)
# -----------------------------------------------------------------------------
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/dist/
frontend/build/
frontend/.vercel/
frontend/tsconfig.tsbuildinfo
frontend/.turbo/

# Next.js cache
frontend/.next/cache/

# npm / yarn / pnpm
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*
frontend/.pnpm-debug.log*
frontend/.yarn/cache
frontend/.yarn/unplugged
frontend/.yarn/build-state.yml
frontend/.yarn/install-state.gz

# TypeScript incremental builds
*.tsbuildinfo


# -----------------------------------------------------------------------------
# Python / FastAPI (backend/)
# -----------------------------------------------------------------------------

# Virtual environments
backend/venv/
backend/.venv/
backend/env/
backend/.env_venv/
backend/ENV/
backend/.pyenv/

# Byte-compiled / optimised / DLL files
backend/__pycache__/
backend/**/__pycache__/
**/__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
backend/*.egg-info/
backend/dist/
backend/build/
backend/.eggs/
backend/site-packages/

# Testing & coverage
backend/.pytest_cache/
backend/.coverage
backend/coverage.xml
backend/htmlcov/
backend/.hypothesis/
backend/.tox/
backend/nosetests.xml
backend/test-results/

# MyPy / type checkers
backend/.mypy_cache/
backend/.dmypy.json
backend/dmypy.json
backend/.pytype/
backend/.pyre/

# Celery
backend/celerybeat-schedule
backend/celerybeat.pid

# Scratch / temp files
backend/scratch/


